# Playwright
node_modules/
__pycache__/
*.pyc
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
# Anchored: only the package-root build output dir; src/build and tests/build
# are real source and must stay trackable.
/build/
# Public release assets are generated outside the normal development build.
/release/
assets/*
!assets/source-data-manifest.json
fixture
# Source-HTML render fixtures: regenerated from assets/MWU.db via
# `bun run update:render-fixtures` (same provenance as the build itself).
/tests/rendered/fixtures/

# Keep build-focused integration tests visible; the build/ rule above is
# intentionally broad for generated artifacts.
!tests/build/
!tests/build/*.test.ts

/build-shots
