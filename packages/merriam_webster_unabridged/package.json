{
  "name": "merriam_webster_unabridged",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build:selected": "bun run src/index.ts",
    "build:full": "bun run src/index.ts --full",
    "inventory:functional-labels": "bun run src/index.ts --inventory:functional-labels",
    "dev:build": "bun run src/index.ts --words-file tests/testWords.txt",
    "design:survey": "bun run design-fixtures/survey-html.ts",
    "design:what:zip": "bun run design-fixtures/what/write-zip.ts",
    "design:what": "bun run design:what:zip && bun run tests/verify_styles.ts \"build/design-what/MWU-what-design.zip\" --close",
    "inspect:dict": "bun run dev:build && bun run tests/inspect_dict.ts \"build/Merriam Webster Unabridged.zip\" --query-file tests/testWords.txt --chrome-flag \"--remote-debugging-port=9222\"",
    "coverage:audit": "bun run tests/coverage_audit.ts",
    "survey:inspect": "bun run tests/survey_inspector.ts",
    "update:fixture": "bun run tests/update-fixture.ts",
    "update:render-fixtures": "bun run tests/updateRenderFixtures.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "vitest run --project storybook",
    "debug:unittest": "bun test --inspect-wait=/vscode",
    "unzip": "7z x \"build/Merriam Webster Unabridged.zip\" -o\"build/Merriam Webster Unabridged\" && biome format --write \"build/Merriam Webster Unabridged\" *.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.6.1",
  "dependencies": {
    "cheerio": "^1.0.0",
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@storybook/addon-vitest": "^10.5.7",
    "@storybook/html-vite": "^10.5.7",
    "@types/bun": "^1.2.5",
    "@types/node": "^22.13.10",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "domhandler": "^5.0.3",
    "storybook": "^10.5.7",
    "vitest": "^4.1.10"
  }
}
